# Copie para .env.local (desenvolvimento) e cadastre os mesmos nomes na Vercel (Settings > Environment Variables).

# App web do Firebase (Configuracoes do projeto > Seus apps > Web). Sao publicas.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
NEXT_PUBLIC_FIREBASE_APP_ID=

# Conta de servico (Configuracoes do projeto > Contas de servico > Gerar nova chave privada).
# Cole o JSON inteiro em UMA linha. SECRETA: nunca suba para o GitHub.
FIREBASE_SERVICE_ACCOUNT=

# Seu e-mail do Google: o unico que pode usar "Recalcular agora"
ALLOWED_EMAIL=

# Qualquer texto aleatorio longo; a Vercel o envia ao chamar o cron
CRON_SECRET=

# Opcional: aviso no Telegram (1 vez por candle fechado). TELEGRAM_PREVIEW_ALERTS=1 tambem avisa (1 vez por dia)
# quando o candle de hoje, se fechasse agora, mudaria a acao. (crie o bot com o @BotFather; o chat id vem do @userinfobot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PREVIEW_ALERTS=

# Opcional: carteira on-chain (so leitura pelo endereco publico, que voce informa na Configuracao do site).
# Chave GRATUITA da Zerion (dashboard.zerion.io > API key). SECRETA. A Lighter (perpetuos) nao precisa de chave.
ZERION_API_KEY=
